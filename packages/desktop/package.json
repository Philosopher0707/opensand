{
  "name": "@opensand/desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:tsc": "tsc -b",
    "build:vite": "vite build",
    "test": "node --test dist/test/**/*.test.js",
    "dev": "electron .",
    "start": "node dist/src/desktop-server.js"
  },
  "dependencies": {
    "@opensand/coordinator": "workspace:*",
    "@opensand/local-exec-daemon": "workspace:*",
    "@opensand/native-bridge": "workspace:*",
    "@opensand/shared": "workspace:*",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.10.0",
    "electron": "^45.2.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
