#!/usr/bin/env node
// Fake `codex exec --json` (codex-cli 0.166.0): one JSON event per line. Like the real CLI, it reads stdin to its end
// when stdin is a pipe ("Reading additional input from stdin"), so an engine that leaves stdin open hangs here.
// Prompt markers: LIMIT (usage-limit error, exit 1), FAIL_AUTH (stderr "Error: not logged in", exit 1), HANG (no output).
// Logs argv (sandbox_mode, resume id, -C), stdin kind and pid to $FAKE_LOG.
const fs = require("node:fs");
const args = process.argv.slice(2);
if (args[0] === "--version") { console.log("codex-cli 0.166.0"); process.exit(0); }
if (args[0] === "login" && args[1] === "status") { console.log("Logged in using ChatGPT"); process.exit(0); }
const stdinKind = () => { try { const s = fs.fstatSync(0); return s.isSocket() || s.isFIFO() ? "pipe" : s.isCharacterDevice() ? "null" : "other"; } catch { return "closed"; } };
const resume = args[1] === "resume" ? args[2] : null;
const prompt = args[args.length - 1];
const f = process.env.FAKE_LOG;
if (f) fs.writeFileSync(f, JSON.stringify({ engine: "codex", args, prompt, stdin: stdinKind(), pid: process.pid, cwd: process.cwd() }));
const out = (o) => process.stdout.write(JSON.stringify(o) + "\n");
function main() {
  if (/FAIL_AUTH/.test(prompt)) { console.error("Error: not logged in"); process.exit(1); }
  if (/HANG/.test(prompt)) { setInterval(() => {}, 1000); return; }
  out({ type: "thread.started", thread_id: resume || "thread-abc" });
  out({ type: "turn.started" });
  if (/LIMIT/.test(prompt)) {
    out({ type: "error", message: "You've hit your usage limit. Upgrade to Plus to continue using Codex" });
    out({ type: "turn.failed", error: { message: "usage limit" } });
    process.exit(1);
  }
  out({ type: "item.started", item: { id: "c1", type: "command_execution", command: "cat note.txt", status: "in_progress" } });
  out({ type: "item.completed", item: { id: "c1", type: "command_execution", command: "cat note.txt", aggregated_output: "hello\n", exit_code: 0, status: "completed" } });
  out({ type: "item.completed", item: { id: "t1", type: "todo_list", items: [{ text: "Read", completed: true }, { text: "Write", completed: false }] } });
  out({ type: "item.completed", item: { id: "m1", type: "agent_message", text: resume ? `resumed ${resume}` : "done by codex" } });
  out({ type: "turn.completed", usage: { input_tokens: 10, output_tokens: 5 } });
  process.exit(0);
}
if (stdinKind() === "pipe") { process.stdin.resume(); process.stdin.on("data", () => {}); process.stdin.on("end", main); }
else main();
