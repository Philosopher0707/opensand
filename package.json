{
  "name": "opensand",
  "version": "0.1.2",
  "private": true,
  "description": "Universal Open-Source Clean-Room Desktop Agent",
  "type": "module",
  "scripts": {
    "test": "pnpm --recursive run test",
    "build": "pnpm --recursive run build",
    "dev:desktop": "pnpm --filter @opensand/desktop dev",
    "package:cli": "bash scripts/package-cli.sh",
    "stage:desktop": "rm -rf dist/stage && pnpm --filter @opensand/desktop... run build && pnpm --filter @opensand/desktop deploy --prod --legacy dist/stage",
    "package:app": "node scripts/sync-versions.js --check && pnpm stage:desktop && electron-builder --mac --publish never",
    "package": "bash scripts/package-cli.sh && pnpm package:app",
    "package:mac": "pnpm package:app",
    "sync-versions": "node scripts/sync-versions.js",
    "version:sync": "node scripts/sync-versions.js",
    "version:check": "node scripts/sync-versions.js --check",
    "eval": "node --experimental-strip-types evals/eval-runner.ts"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=11.0.1"
    }
  }
}
